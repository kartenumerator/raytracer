vec4 diffuse(vec3 origin, vec3 n, int selfidx, ivec2 sampl, ivec2 pixel, int nbounces) {
    // Build TBN basis aligned to surface normal
    vec3 up = abs(n.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 tangent   = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);

    float golden_angle = PI * (3.0 - sqrt(5.0)); // correct golden angle in radians
    int n_points = 5;
    int nn = 0;
    vec4 return_color = vec4(0);
    // int idx = frame*200;
    // for (int i = idx%n_points; i < min((idx%n_points)+200,n_points); i++) {
    for (int i = 0; i < n_points; i++) {
        // Generate hemisphere sample in local space

        // for(int j = 0; j<1; j++){
            // int i = (int(random(uint(frame+j))*n_points ));
            vec3 ro = vec3(origin);
            float prevt = -10.0;
            vec4 retcolor = vec4(0);
            float reflectivity = 1.0;
            for (int j = 0; j < nbounces; j++) {
                float theta = rand(vec2(float(i+frame+pixel.x+pixel.y + ro.x), float(ro.y+ro.z + sampl.x+sampl.y+frame)));
                float phi = rand(vec2(float(ro.y+ro.z + sampl.x+sampl.y+frame),float(i+frame+pixel.x+pixel.y + ro.x)))*2*PI;

                float cosTheta = 1 - 2*theta; // 0..1
                float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
                // Local hemisphere direction (Z-up)
                vec3 localDir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
                
                // float cosTheta = float(i) / float(n_points - 1); // 0..1
                // float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
                // float phi = golden_angle * float(i);

                // // Local hemisphere direction (Z-up)
                // vec3 localDir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

                // Rotate into world/view space using TBN
                vec3 rd = normalize(localDir.x * tangent + localDir.y * bitangent + localDir.z * n);
                if (dot(n,rd) < 0.0) {
                    rd *= -1.0;    
                }

                HitInfo h = getHit(ro, rd, false, prevt);
                // if (h.idx == selfidx) continue   ;
                nn++;
                if (h.idx == -2) {
                    retcolor += ((h.col * h.reflectiveness * (max(dot(n,rd),0.0))*0.8)/(1.0 + 0.005 * h.t*h.t));
                    return_color += retcolor;
                    break;
                    // return retcolor/ float(nn);
                }else if (h.idx == -1) {
                    retcolor += h.col * (1 - h.reflectiveness) * max(dot(n,rd),0.0);
                    return_color += retcolor;
                    break;
                }
                else {
                    reflectivity *= h.reflectiveness;
                    retcolor += h.col * (reflectivity) * max(dot(n,rd),0.0);
                    ro = ro + rd * h.t + h.normal * max(1e-4, h.t * 1e-5);
                }
                prevt = h.t;
            }
            // break;
        }

    // }

    return_color /= float(nn);
    return return_color;
}

vec4 trace_ray(vec3 ro, vec3 rd, int numreflect, ivec2 sampl, ivec2 pixel) {
    // int numreflections = 2;
    float prevrefl = 1.0;
    vec4 final_color = vec4(0,0,0,1);
    float l = 0;
    float prevt = -10.0;
    for (int j = 0; j<numreflect; j++){
        HitInfo h = getHit(ro, rd, false, prevt);
        
        vec3 intersectpoint = ro + rd * h.t;
        // for(int i = 0; i<light.length()/7; i++){
        //     vec3 point_light = vec3(light[i*7 + 0], light[i*7 + 1], light[i*7 + 2]);
        //     float h.reflectiveness = light[i*7 + 3];
        //     vec3 light_color = vec3(light[i*7 + 4], light[i*7 + 5], light[i*7 + 6]);
        //     point_light = (view * vec4(point_light, 1.0)).xyz; // Transform point light to view space
    
        // }
            vec3 interpoint = intersectpoint +  h.normal * epsilon;
            
            vec4 diffuseContrib = (1.0 - h.reflectiveness) * h.col;
            if (h.hit){
                diffuseContrib *= diffuse(interpoint, h.normal, h.idx, sampl, pixel, 5);
            }
            
            vec4 localcol = diffuseContrib;
            
            if (h.idx == -2){
        // final_color = vec4(1);
        // break;
                final_color += prevrefl*clamp(h.col * h.reflectiveness / h.t, 0.0, 1.0);
            }else {
                final_color += prevrefl*clamp(vec4(localcol.rgb,1.0), 0.0, 1.0);
            }
        rd = rd - 2*(dot(rd,h.normal))*h.normal;
        l += length(ro-intersectpoint);
        ro = intersectpoint +  h.normal * epsilon;
        
        prevrefl *= h.reflectiveness;
        if (!h.hit || h.idx == -2){
            break;
        }

        prevt = h.t;
    }

    final_color /= numreflect;
    return final_color;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_resolution.x) || pixel.y >= int(u_resolution.y)) return;

    int nsamples = 2;

    vec4 final_color = vec4(0,0,0,1);

    ground = normalize((view * vec4(ground + ground_point, 1.0)).xyz); // Transform ground normal to view space
    ground_point = (view * vec4(ground_point, 1.0)).xyz; // Transform ground point to view space
    ground -= ground_point;
    
    ground = normalize(ground); // Normalize the ground normal

    for (int samplx = 0; samplx<nsamples; samplx++){
        for (int samply = 0; samply<nsamples; samply++){

            vec2 uv = (vec2(pixel.x+(samplx-nsamples/2)/2.0, pixel.y+(samply-nsamples/2)/2.0) + 0.5) / u_resolution * 2.0 - 1.0;
            // uv.x += samplx/10;
            uv.y = -uv.y; // flip

            float z = -1.0 / tan(radians(fov) * 0.5);
            vec3 rd = normalize((invView * vec4(vec3(uv, z), 0.0)).xyz);
            vec3 ro = (invView * vec4(vec3(0,0,0), 1.0)).xyz;


            // Ray direction in NDC
            int numreflections = 2;

            final_color += trace_ray(ro,rd,numreflections, ivec2(samplx*5, samply*5), pixel);
        }
    }

    final_color /= nsamples*nsamples;
    // final_color = vec4(1);
    imageStore(imgOutput, pixel, final_color);
    
}
