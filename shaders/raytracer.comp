};

bool intersectSphere(vec3 ro, vec3 rd, Circle c, out float tHit) {
    // c.pos = (view * vec4(c.pos, 1.0)).xyz; // Transform circle position to view space
    vec3 oc = ro - c.pos;//(view * vec4(c.pos, 1.0)).xyz;
    float a = dot(rd, rd);
    float b = 2.0 * dot(oc, rd);
    float cc = dot(oc, oc) - c.radius*c.radius;
    float disc = b*b - 4.0*a*cc;
    if(disc < 0.0) return false;
    float t0 = (-b - sqrt(disc)) / (2.0*a);
    float t1 = (-b + sqrt(disc)) / (2.0*a);
    tHit = (t0 > 0.0) ? t0 : ((t1 > 0.0) ? t1 : -1.0);
    return tHit > 0.0;
}

vec3 skybox(vec3 rdir){
    // return vec3(0);
    vec3 dir = vec3(rdir.x + cos(0)*sin(frame*0.01), rdir.y + sin(0)*sin(frame*0.01), rdir.z + cos(frame*0.01));
    vec3 rd = rdir;//normalize((invView * vec4(rdir,0.0)).xyz); // Transform ray direction to view space
    
    ivec2 pixel = ivec2(int((atan(rd.z, rd.x) / (2.0 * PI) + 0.5) * sky_resolution.x), int((asin(clamp(rd.y, -1.0, 1.0)) / PI + 0.5) * sky_resolution.y));
    pixel.y = int(sky_resolution.y) - pixel.y - 1; // Flip Y for image lookup
    pixel = clamp(pixel, ivec2(0), ivec2(sky_resolution.x, sky_resolution.y) - 1);
    return clamp(imageLoad(skyboxtex, pixel).xyz, 0.0, 1.0);
    // return vec3((sky_resolution.x)/1200, (sky_resolution.y), 0.0); // Debug: visualize UV coords
    // return clamp(imageLoad(skyboxtex, ivec2(1,1)), 0.0, 1.0);
}

bool intersectTriangle(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, vec3 n0, vec3 n1, vec3 n2, out float t, out vec3 normal, int hasnormal) {

    // v0 = (view * vec4(v0, 1.0)).xyz; // Transform triangle vertices to view space
    // v1 = (view * vec4(v1, 1.0)).xyz;
    // v2 = (view * vec4(v2, 1.0)).xyz;

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 edge3 = v2 - v1;
    normal = normalize(cross(edge1, edge2));
    
    if(hasnormal == 0 && dot(normal, rd) > 0.0) {
        normal = -normal; // Ensure normal faces against ray
    }

    float det = dot(rd,normal);
    if (abs(det) < 1e-4) return false; // Ray is parallel to triangle
    
    t = dot(v0 - ro, normal) / det;
    vec3 hitPoint = ro + rd * t;


    float area = length(cross(edge1, edge2))*0.5;
    float a1 = length(cross(v1 - v0, hitPoint - v0))*0.5;
    float a2 = length(cross(v2 - v1, hitPoint - v1))*0.5;
    float a3 = length(cross(v0 - v2, hitPoint - v2))*0.5;
    float areapoint = a1 + a2 + a3;
    if (abs(area - areapoint) > 1e-4) return false;

    if (hasnormal == 1){
        normal = (n0 * (a2/areapoint) + n1 * (a3/areapoint) + n2 * (a1/areapoint));
    }

    return t > 0.0;
}

bool intersectBoundingBox(vec3 o, vec3 dim, vec3 ro, vec3 rd){
    if (rd.x == 0){
        rd.x = 1e-5;
    }
    if (rd.y == 0){
        rd.y = 1e-5;
    }
    if (rd.z == 0){
        rd.z = 1e-5;
    }
    vec3 tmin = (ro - o)/rd;
    vec3 tmax = (ro -(o+dim))/rd;
    float tm = max(tmin.x,max(tmin.y,tmin.z));
    float tmx = min(tmax.x, min(tmax.y,tmax.z));

    return (tmx) <= (tm);
    // return true;
}

